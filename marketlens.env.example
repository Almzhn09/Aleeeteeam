# Copy to .env.marketlens.local at the repository root. Set both project IDs
# to the same dedicated MarketLens Firebase project. Browser settings are public.
MARKETLENS_FIREBASE_ENABLED=false
MARKETLENS_FIREBASE_PROJECT_ID=demo-marketlens-local
# Prefer application-default credentials scoped to the dedicated project.
# MARKETLENS_FIREBASE_CREDENTIALS_PATH=/absolute/path/to/service-account.json
VITE_MARKETLENS_FIREBASE_PROJECT_ID=demo-marketlens-local
VITE_MARKETLENS_FIREBASE_API_KEY=
VITE_MARKETLENS_FIREBASE_AUTH_DOMAIN=
VITE_MARKETLENS_FIREBASE_APP_ID=
# Leave blank for the Vite same-origin API proxy.
VITE_MARKETLENS_API_BASE_URL=
# Optional backend integration. Leave blank to use local explanations.
MARKETLENS_GEMINI_MODEL=
MARKETLENS_GEMINI_API_KEY=

MARKETLENS_OPENAI_MODEL=
MARKETLENS_OPENAI_API_KEY=
