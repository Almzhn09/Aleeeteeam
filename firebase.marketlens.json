{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.marketlens.indexes.json" },
  "hosting": {
    "public": "frontend/dist-marketlens",
    "ignore": ["firebase.marketlens.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] },
      { "source": "/release.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }] }
    ]
  }
}
